#!/usr/bin/env bash
# rmsync — rsync-based fast file/directory remover
# Usage: rmsync [path ...]
#   path: relative (resolved from $PWD) or absolute
#   no args: just flush DIR_B using rsync
# wget https://raw.githubusercontent.com/devtonull/lnmp/refs/heads/main/add/bin/rmsync -O /usr/local/bin/rmsync && chmod +x /usr/local/bin/rmsync
# sudo mv rmsync /usr/local/bin/
# chmod +x /usr/local/bin/rmsync

set -euo pipefail

# ── Configuration ────────────────────────────────────────────────────────────
DIR_A="/home/wwwlogs/.rm/a"   # always empty source
DIR_B="/home/wwwlogs/.rm/b"   # staging area to be wiped

# ── Colour output ─────────────────────────────────────────────────────────────
RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'
CYAN='\033[0;36m'; RESET='\033[0m'; BOLD='\033[1m'

info()  { echo -e "${CYAN}[rmsync]${RESET} $*"; }
ok()    { echo -e "${GREEN}[rmsync]${RESET} $*"; }
warn()  { echo -e "${YELLOW}[rmsync]${RESET} $*" >&2; }
die()   { echo -e "${RED}[rmsync]${RESET} $*" >&2; exit 1; }

# ── Preflight checks ──────────────────────────────────────────────────────────
command -v rsync >/dev/null 2>&1 || die "rsync not found. Please install rsync."

# Ensure DIR_A exists and is empty (the "empty source")
if [[ ! -d "$DIR_A" ]]; then
  warn "DIR_A ($DIR_A) not found, creating..."
  mkdir -p "$DIR_A" || die "Cannot create $DIR_A"
fi

# DIR_A must stay empty — guard against accidental contamination
if [[ -n "$(ls -A "$DIR_A" 2>/dev/null)" ]]; then
  die "DIR_A ($DIR_A) is not empty! Aborting to avoid data loss."
fi

# Ensure DIR_B exists (staging area)
if [[ ! -d "$DIR_B" ]]; then
  warn "DIR_B ($DIR_B) not found, creating..."
  mkdir -p "$DIR_B" || die "Cannot create $DIR_B"
fi

# ── Helper: resolve and validate a target path ────────────────────────────────
resolve_target() {
  local arg="$1"
  local target

  # Absolute path starts with /
  if [[ "$arg" == /* ]]; then
    target="$arg"
  else
    target="$PWD/$arg"
  fi

  # Normalize (remove trailing slash, double slashes, etc.)
  target="$(realpath -m "$target")"

  echo "$target"
}

# ── Safety guard: prevent nuking critical paths ───────────────────────────────
PROTECTED_PATHS=(
  "/"
  "/bin" "/sbin" "/usr" "/etc" "/lib" "/lib64"
  "/boot" "/dev" "/proc" "/sys" "/run"
  "/home" "/root" "/tmp" "/var"
  "$DIR_A" "$DIR_B"
)

is_protected() {
  local t="$1"
  for p in "${PROTECTED_PATHS[@]}"; do
    if [[ "$t" == "$p" || "$t" == "$p/"* && "$p" == "/" ]]; then
      return 0
    fi
    if [[ "$t" == "$p" ]]; then
      return 0
    fi
  done
  return 1
}

# ── Step: move targets into DIR_B ─────────────────────────────────────────────
move_targets() {
  local had_error=0

  for arg in "$@"; do
    local target
    target="$(resolve_target "$arg")"

    # Existence check
    if [[ ! -e "$target" && ! -L "$target" ]]; then
      warn "Not found, skipping: $target"
      had_error=1
      continue
    fi

    # Safety check
    if is_protected "$target"; then
      die "Refusing to remove protected path: $target"
    fi

    # Prevent moving DIR_B into itself
    if [[ "$target" == "$DIR_B" || "$target" == "$DIR_B/"* ]]; then
      warn "Target is inside DIR_B, skipping: $target"
      had_error=1
      continue
    fi

    # Destination name collision: append timestamp if name already exists in DIR_B
    local basename
    basename="$(basename "$target")"
    local dest="$DIR_B/$basename"
    if [[ -e "$dest" ]]; then
      local ts
      ts="$(date +%s%N 2>/dev/null || date +%s)"
      dest="${dest}_${ts}"
      warn "Name collision — renaming to: $(basename "$dest")"
    fi

    info "Moving: $target → $DIR_B/"
    if mv -f "$target" "$dest"; then
      ok "Moved: $target"
    else
      warn "Failed to move: $target"
      had_error=1
    fi
  done

  return $had_error
}

# ── Step: rsync wipe DIR_B ────────────────────────────────────────────────────
rsync_wipe() {
  info "Wiping ${BOLD}$DIR_B${RESET} via rsync..."
  rsync -av --delete "$DIR_A/" "$DIR_B/"
  ok "Done. DIR_B is now empty."
}

# ── Main ──────────────────────────────────────────────────────────────────────
main() {
  if [[ $# -eq 0 ]]; then
    info "No arguments — flushing $DIR_B"
    rsync_wipe
    exit 0
  fi

  # Move all targets first, then wipe
  local move_ok=0
  move_targets "$@" || move_ok=$?

  if [[ $move_ok -ne 0 ]]; then
    warn "Some targets could not be moved. rsync wipe will still run."
  fi

  rsync_wipe
}

main "$@"
