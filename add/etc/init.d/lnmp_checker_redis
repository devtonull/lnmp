#!/bin/bash
### BEGIN INIT INFO
# Provides:          lnmp_checker_redis
# Required-Start:    $all
# Required-Stop:     $all
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Check if redis process exists
### END INIT INFO

# wget https://raw.githubusercontent.com/devtonull/lnmp/refs/heads/main/add/etc/init.d/lnmp_checker_redis -O /etc/init.d/lnmp_checker_redis
# chmod +x /etc/init.d/lnmp_checker_redis
# update-rc.d lnmp_checker_redis defaults
# /etc/init.d/lnmp_checker_redis >/dev/null 2>&1 &

# 等待系统服务启动
sleep 30

LOG_FILE="/home/wwwlogs/lnmp_checker_redis.log"

# 检查 redis 进程
check_redis() {
    pgrep redis >/dev/null 2>&1
}

# 判断 redis 是否存在
if check_redis; then
    echo "$(date) redis is already running." >> "$LOG_FILE"
    exit 0
else
    echo "$(date) redis is not running. Starting redis..." >> "$LOG_FILE"

    # 启动 redis
    /etc/init.d/redis start

    # 再次检查
    sleep 3

    if check_redis; then
        echo "$(date) redis started successfully." >> "$LOG_FILE"
    else
        echo "$(date) failed to start redis." >> "$LOG_FILE"
    fi
fi
